# Copy to .env (which git ignores) and fill in. Everything except the API key is optional.

# Required for generation and for reading scanned PDFs. Never commit it or put it in the frontend.
ANTHROPIC_API_KEY=

# Which Claude model generates questions, and how hard it thinks (low | medium | high | xhigh | max).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Resumes sent to Claude at once during a bulk upload.
# GENERATION_CONCURRENCY=3

# Any SQLAlchemy URL. Defaults to a SQLite file at app/back_end/calibrate.db.
# Postgres example (also needs `pip install "psycopg[binary]"`):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/calibrate

# JSON list of browser origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
